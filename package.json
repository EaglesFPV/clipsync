{
  "name": "clipsync",
  "version": "1.0.0",
  "description": "Synchronisation chiffrée du presse-papier entre PC et téléphone, en réseau local uniquement.",
  "author": "EaglesFPV",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "prebuild-icon": "node scripts/build-icon.js",
    "dist": "npm run prebuild-icon && electron-builder --win --publish never"
  },
  "dependencies": {
    "qrcode": "^1.5.4",
    "selfsigned": "^2.4.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "electron": "^43.0.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "fr.astrolab.clipsync",
    "productName": "ClipSync",
    "files": [
      "electron/**/*",
      "server/**/*",
      "web/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
