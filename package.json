{
  "name": "clipsync",
  "version": "1.0.0",
  "description": "Synchronisation chiffrée de bout en bout du presse-papier entre PC et téléphone(s), en local ou à distance.",
  "author": "EaglesFPV",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "prebuild-icon": "node scripts/build-icon.js",
    "dist": "npm run prebuild-icon && electron-builder --win --publish never",
    "android:sync": "cap sync android"
  },
  "dependencies": {
    "@achingbrain/nat-port-mapper": "^4.0.5",
    "@capacitor/android": "^8.5.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/clipboard": "^8.0.1",
    "@capacitor/core": "^8.5.0",
    "electron-updater": "^6.3.9",
    "qrcode": "^1.5.4",
    "selfsigned": "^2.4.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "electron": "^43.0.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "fr.astrolab.clipsync",
    "productName": "ClipSync",
    "files": [
      "electron/**/*",
      "server/**/*",
      "web/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "publish": {
      "provider": "github",
      "owner": "EaglesFPV",
      "repo": "clipsync"
    },
    "extraResources": [
      {
        "from": "build/app-update.yml",
        "to": "app-update.yml"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
